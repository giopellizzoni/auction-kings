# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored and never committed.
# Actual passwords are in docker/secrets/

# PostgreSQL
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=AuctionKingsDB;Username=dev;Password=

# Redis
ConnectionStrings__Redis=localhost:6379

# JWT signing key (dotnet run). No key is committed to the repo; scripts/setup-local-env.sh
# generates one into .env.local. It must be at least 32 bytes — for example `openssl rand -hex 32`.
# The API refuses to start if it is missing, empty, too short, or the old committed placeholder.
# Issuer/Audience come from appsettings.Development.json; don't set them here.
# The docker-compose all-in-one path gets its secret separately, from JWT_SECRET in
# docker/.env.local — see docker/.env for that template.
Jwt__Secret=

# AWS local endpoints (LocalStack / Moto)
AWS__SQS__ServiceURL=http://localhost:4566
AWS__SQS__BidQueueUrl=http://localhost:4566/000000000000/auction-bids-queue
AWS__Cognito__ServiceURL=http://localhost:5555
MediatR__License=
