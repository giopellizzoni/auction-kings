# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored and never committed.
# Actual passwords are in docker/secrets/

# PostgreSQL
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=AuctionKingsDB;Username=dev;Password=

# Redis
ConnectionStrings__Redis=localhost:6379

# JWT (dotnet run only — do NOT set these here.
# appsettings.Development.json already has a valid dev signing key.
# Setting Jwt__Secret to an empty string overrides it via env-var config
# precedence and crashes the API on the very first request with
# "IDX10703: key length is zero", including unauthenticated endpoints,
# because JwtBearerOptions are constructed lazily by the auth middleware.
# The docker-compose all-in-one path gets its JWT secret separately, from
# JWT_SECRET in docker/.env.local — see docker/.env for that template.)

# AWS local endpoints (LocalStack / Moto)
AWS__SQS__ServiceURL=http://localhost:4566
AWS__SQS__BidQueueUrl=http://localhost:4566/000000000000/auction-bids-queue
AWS__Cognito__ServiceURL=http://localhost:5555
MediatR__License=
