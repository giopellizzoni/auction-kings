POSTGRES_USER=dev
POSTGRES_DB=AuctionKingsDB

POSTGRES_HOST_PORT=5432
POSTGRES_CONTAINER_PORT=5432
POSTGRES_PASSWORD_FILE=./secrets/postgres_password.txt
# Same value as secrets/postgres_password.txt — used by the api container
# (docker-compose.yml), which reads a plain env var, not the _FILE secret.
POSTGRES_PASSWORD=

REDIS_HOST_PORT=6379
REDIS_CONTAINER_PORT=6379
REDIS_PASSWORD_FILE=./secrets/redis_password.txt
# Same value as secrets/redis_password.txt — used by the api container
# (docker-compose.yml), which reads a plain env var, not the _FILE secret.
REDIS_PASSWORD=

# Required by the api container (docker-compose.yml). Generate with:
# openssl rand -base64 48 | tr -d '\n'
JWT_SECRET=
