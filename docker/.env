POSTGRES_USER=dev
POSTGRES_DB=AuctionKingsDB

POSTGRES_HOST_PORT=5432
POSTGRES_CONTAINER_PORT=5432
POSTGRES_PASSWORD_FILE=./secrets/postgres_password.txt
# Same value as secrets/postgres_password.txt — used by the api container
# (docker-compose.yml), which reads a plain env var, not the _FILE secret.
POSTGRES_PASSWORD=

REDIS_HOST_PORT=6379
REDIS_CONTAINER_PORT=6379
REDIS_PASSWORD_FILE=./secrets/redis_password.txt
# Same value as secrets/redis_password.txt — used by the api container
# (docker-compose.yml), which reads a plain env var, not the _FILE secret.
REDIS_PASSWORD=

# Grafana admin password (user: admin). Generated by scripts/setup-local-env.sh.
GRAFANA_PASSWORD_FILE=./secrets/grafana_admin_password.txt

# Required by the api container (docker-compose.yml). Generate with:
# openssl rand -base64 48 | tr -d '\n'
JWT_SECRET=

# MediatR license key (free Community edition: https://luckypennysoftware.com). Optional: blank is
# treated as unconfigured. Put the real key in docker/.env.local, never in this file.
MEDIATR_LICENSE=
