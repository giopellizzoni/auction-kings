# Local Terraform state — use remote backend (S3) instead
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Secret variable files — use tfvars.example as template
terraform.tfvars
*.auto.tfvars

# Crash logs
crash.log
crash.*.log

# Lambda packages built by data.archive_file at plan time
.build/

# Plan output files
*.tfplan
