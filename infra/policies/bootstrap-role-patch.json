{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ModifySubnetAndDescribeEIP",
      "Effect": "Allow",
      "Action": ["ec2:ModifySubnetAttribute", "ec2:DescribeAddressesAttribute"],
      "Resource": "*"
    },
    {
      "Sid": "CreateServiceLinkedRoles",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::314146334477:role/aws-service-role/*",
      "Condition": {
        "StringLike": {
          "iam:AWSServiceName": [
            "ecs.amazonaws.com",
            "elasticache.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "TerraformStateBackend",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::auction-kings-terraform-state",
        "arn:aws:s3:::auction-kings-terraform-state/staging/*"
      ]
    },
    {
      "Sid": "TerraformStateLocking",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:DeleteItem",
        "dynamodb:DescribeTable"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:314146334477:table/auction-kings-terraform-locks"
    }
  ]
}
